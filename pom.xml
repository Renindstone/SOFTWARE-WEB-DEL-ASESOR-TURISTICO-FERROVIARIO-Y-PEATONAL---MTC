  <scope>provided</scope>
</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<!-- RF-08: generacion del informe consolidado en PDF (GeneradorPdf).
			     Fijado en 2.0.5 (no 3.x) porque esa serie requiere Java 21;
			     2.0.5 declara java.version=17 y usa el paquete com.lowagie.text. -->
			<groupId>com.github.librepdf</groupId>
			<artifactId>openpdf</artifactId>
			<version>2.0.5</version>
		</dependency>
		<dependency>
			<!-- Solo para pruebas: permite levantar el contexto de Spring y
			     ejecutar la matriz de caja blanca (seccion 8.2.1) sin exigir
			     el contenedor PostgreSQL. En ejecucion real el motor sigue
			     siendo PostgreSQL 15 (arquitectura, seccion 5). -->
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<!-- Solo para VerificacionIntegridadBdTest. Los verificadores de
			     integridad (fn_verificar_categorias, fn_verificar_rutas) estan
			     escritos en plpgsql dentro de init/03_consultas.sql, asi que H2 no
			     puede ejecutarlos: esa prueba levanta un PostgreSQL 15 con los
			     mismos scripts de init que monta el docker-compose. El resto de la
			     suite sigue corriendo sobre H2 sin necesitar Docker.
			     La version la fija el BOM de Spring Boot (testcontainers 2.0.5). -->
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
